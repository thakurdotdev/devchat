# Copy to .env and adjust. Server reads these on boot (see server/src/config.ts).
PORT=3030
REDIS_URL=
ROOM_TTL_HOURS=24
EMPTY_ROOM_GRACE_MIN=15
MAX_MEMBERS=50
MESSAGE_HISTORY=100
KLIPY_BASE_URL=https://klipy.thakur.dev
MYINSTANTS_BASE_URL=https://myinstants.thakur.dev
GIF_CACHE_TTL_SEC=300
SOUND_CACHE_TTL_SEC=300
# Serve local fixtures instead of hitting upstream media APIs (offline dev)
MOCK_MEDIA=true
# Generous anti-abuse limits; Redis shares quotas across server instances.
ROOM_CREATE_RATE_PER_HOUR=10
ROOM_LOOKUP_RATE_PER_MINUTE=120
ROOM_JOIN_RATE_PER_MINUTE=120
MEDIA_RATE_PER_MINUTE=60
WS_CONNECTIONS_PER_IP=100
WS_CONNECTIONS_GLOBAL=5000
WS_FRAMES_PER_MINUTE=120
WS_MESSAGE_BYTES=16384
# Enable only behind a proxy that overwrites forwarded-IP headers.
TRUST_PROXY=true
ALLOWED_WS_ORIGINS=
