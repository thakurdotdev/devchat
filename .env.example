# Copy to .env and adjust. Server reads these on boot (see server/src/config.ts).
PORT=3030
REDIS_URL=
ROOM_TTL_HOURS=24
EMPTY_ROOM_GRACE_MIN=15
MAX_MEMBERS=50
MESSAGE_HISTORY=100
KLIPY_BASE_URL=https://klipy.thakur.dev
MYINSTANTS_BASE_URL=https://myinstants.thakur.dev
GIF_CACHE_TTL_SEC=300
SOUND_CACHE_TTL_SEC=300
# Serve local fixtures instead of hitting upstream media APIs (offline dev)
MOCK_MEDIA=true
